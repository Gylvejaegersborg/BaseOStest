# Weather proxy — copy to `.env` and adjust.

# Port the proxy listens on (the app's VITE_WEATHER_PROXY_URL points here).
PORT=8788

# CORS origin allowed to call the proxy. Use your app's origin in prod
# (e.g. https://os.isark.dev) — or "*" for local dev.
ALLOWED_ORIGIN=*

# Default MeteoAlarm country feed (lowercase English name, e.g. norway, sweden,
# germany, france). The app can override per request with ?country=.
METEOALARM_COUNTRY=norway

# How long to cache upstream responses, in milliseconds (be a good citizen).
CACHE_TTL_MS=300000

# Optional: Met Office Weather DataHub API key. When unset, /metoffice returns
# 503 (not configured). Get one at https://datahub.metoffice.gov.uk/
METOFFICE_API_KEY=
