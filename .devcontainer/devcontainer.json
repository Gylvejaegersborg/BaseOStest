{
  "name": "Personal OS",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  // Install deps + clone/install agent-os once on first create (setup.sh);
  // start the agent-os gateway + BaseOStest's dev server on every start
  // (start.sh) — see both scripts for what each step does and why.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",

  // Forward Vite's port (auto-opens in the browser) and the Agent-OS
  // gateway's port (does NOT auto-open — it's an API, not a page).
  "forwardPorts": [5173, 8787],
  "portsAttributes": {
    "5173": {
      "label": "Personal OS",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "8787": {
      "label": "Agent-OS gateway",
      "onAutoForward": "notify",
      "protocol": "http",
      "visibility": "public"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
