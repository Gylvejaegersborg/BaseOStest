# Discord bridge service — copy to `.env` and fill in.

# Bot token from the Discord developer portal. NEVER commit this.
DISCORD_BOT_TOKEN=

# Port the bridge listens on (the dashboard's VITE_DISCORD_BRIDGE_URL points here).
PORT=8787

# CORS origin allowed to call the bridge. Use your dashboard's origin in prod,
# e.g. https://os.isark.dev — or "*" for local dev.
ALLOWED_ORIGIN=*

# Optional: your own Discord user ID. Messages from this user (and from the bot
# itself) render as "You" in the dashboard. Comma-separate for multiple.
OPERATOR_USER_IDS=
