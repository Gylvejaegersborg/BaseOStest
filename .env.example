# Discord Bot Dashboard — bridge service connection.
# Copy to `.env.local` and point at your running bot service (Node + discord.js).
# When unset, the dashboard runs on bundled mock data.

# Base URL of the bridge service (no trailing slash).
# e.g. http://homeserver.local:8787  or  https://bridge.isark.dev
VITE_DISCORD_BRIDGE_URL=

# Optional: explicit WebSocket URL for live streaming.
# Defaults to VITE_DISCORD_BRIDGE_URL with http→ws + `/gateway`.
VITE_DISCORD_BRIDGE_WS=

# Agent-OS gateway — authoritative agent registry + runtime (see the
# agent-os repo's src/gateway). When unset, agent identity/status shown in
# the dashboard falls back to the bundled presentational roster
# (src/data/agents.ts): colors/chatter/stats always come from there, but
# name/role/model/live-status are replaced by the gateway's answer once
# configured and reachable.
# e.g. http://localhost:8787  or  http://homeserver.local:8787
VITE_AGENT_OS_GATEWAY_URL=

# Weather section — optional proxy for feeds the browser can't reach directly
# (EUMETNET MeteoAlarm alerts, keyed Met Office). Point at the weather-proxy
# service (see /weather-proxy). When unset, Weather runs on its live
# browser-reachable feeds (MET, Open-Meteo, NOAA SWPC) + generated fallback.
# e.g. http://homeserver.local:8788  or  https://wx-proxy.isark.dev
VITE_WEATHER_PROXY_URL=
